<?xml version="1.0"?>
<extension key="grant_hide_fields" type="module">
  <file>grant_hide_fields</file>
  <name>Hide Grant Fields</name>
  <description>Hides selected fields on the grant add, edit and view screens.</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Roger Cliffe</name>
      <email>12166331+rcliffe@users.noreply.github.com</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/rcliffe/grant_hide_fields</url>
    <url desc="Documentation">https://github.com/rcliffe/grant_hide_fields#readme</url>
    <url desc="Support">https://github.com/rcliffe/grant_hide_fields/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-29</releaseDate>
  <version>1.0.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <comments>Semantic versioning. For example, compatibility with "6.1" implies compatibility with "6.2".</comments>
    <ver>6.19</ver>
  </compatibility>
  <php_compatibility mode="list">
    <comments>Listed versions. For example, specify both "8.1" and "8.2".</comments>
    <ver>8.0</ver>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <requires>
    <ext>civigrant</ext>
  </requires>
  <smarty_compatibility mode="list">
    <comments>Listed versions. For example, specify both "4" and "5".</comments>
    <ver>5</ver>
  </smarty_compatibility>
  <comments>Fields are hidden from view only; their stored values are kept.</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/GrantHideFields</namespace>
    <format>26.10.3</format>
    <angularModule>crmGrantHideFields</angularModule>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
  </mixins>
</extension>
